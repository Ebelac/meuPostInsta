# API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Instagram Credentials
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# News Sources API Keys
NEWS_API_KEY=your_news_api_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Database
DATABASE_URL=sqlite:///./instagram_automation.db

# Scheduling
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Content Settings
MAX_POSTS_PER_DAY=3
POST_SCHEDULE_TIMES=["09:00", "14:00", "19:00"]
CONTENT_CATEGORIES=["AI", "Machine Learning", "Web Development", "Mobile", "Cybersecurity"]

# Design Settings
BRAND_COLOR_PRIMARY=#1DA1F2
BRAND_COLOR_SECONDARY=#14171A
BRAND_FONT=Arial
LOGO_PATH=./assets/logo.png